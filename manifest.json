{
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "ChatGPT Image Exporter"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://chatgpt.com/images*"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "Bulk export ChatGPT Images library to a ZIP archive. Local-only. No telemetry.",
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "ChatGPT Image Exporter",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "version": "1.0.2",
  "web_accessible_resources": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "resources": [
        "injected.js"
      ]
    }
  ]
}
